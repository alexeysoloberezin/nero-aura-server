--

CREATE POLICY "Select courses for admin" ON public.courses FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = 'admin'::text)))));


--
-- Name: profiles Update User; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Update User" ON public.profiles FOR UPDATE TO authenticated USING (((auth.uid() = id) OR (role = 'admin'::text))) WITH CHECK (((auth.uid() = id) OR (role = 'admin'::text)));


--
-- Name: profiles Update own profile (except role and hasSub); Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Update own profile (except role and hasSub)" ON public.profiles FOR UPDATE TO authenticated USING ((auth.uid() = id)) WITH CHECK (((auth.uid() = id) AND (NOT (role IS DISTINCT FROM role)) AND (NOT ("hasSub" IS DISTINCT FROM "hasSub"))));


