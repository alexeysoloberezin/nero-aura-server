--
-- Name: profiles Admins can do anything; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can do anything" ON public.profiles USING ((auth.uid() = '9bb60211-56e7-4008-980f-bf8817ef5c4d'::uuid));


--
-- Name: courses_list Admins can insert courses; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can insert courses" ON public.courses_list FOR INSERT WITH CHECK ((auth.uid() IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.role = 'admin'::text))));


--
-- Name: courses_list Admins can select courses; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admins can select courses" ON public.courses_list FOR SELECT USING ((auth.uid() IN ( SELECT profiles.id
   FROM public.profiles
  WHERE (profiles.role = 'admin'::text))));


--
-- Name: chats Allow admin to read all chats; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow admin to read all chats" ON public.chats FOR SELECT USING (((auth.role() = 'authenticated'::text) AND (auth.uid() IN ( SELECT users.id
   FROM auth.users
  WHERE ((users.raw_user_meta_data ->> 'role'::text) = 'admin'::text)))));


--
-- Name: phones Allow all users to insert; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow all users to insert" ON public.phones FOR INSERT WITH CHECK (true);


--
-- Name: messages Allow anonymous insert; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow anonymous insert" ON public.messages FOR INSERT WITH CHECK (true);


--
-- Name: messages Allow anonymous read; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow anonymous read" ON public.messages FOR SELECT USING (true);


--
-- Name: chats Allow anonymous to create chat; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow anonymous to create chat" ON public.chats FOR INSERT WITH CHECK (true);


--
-- Name: homeworks Allow delete for owner; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow delete for owner" ON public.homeworks FOR DELETE USING ((auth.uid() = user_id));


--
-- Name: homeworks Allow delete for owner's homeworks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow delete for owner's homeworks" ON public.homeworks FOR DELETE USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.id = homeworks.user_id)))));


--
-- Name: homeworks Allow insert for authenticated users via profiles; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow insert for authenticated users via profiles" ON public.homeworks FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE (profiles.id = auth.uid()))));


--
-- Name: phones Allow public inserts; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow public inserts" ON public.phones FOR INSERT WITH CHECK (true);


--
-- Name: homeworks Allow select for authenticated users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow select for authenticated users" ON public.homeworks FOR SELECT USING ((auth.uid() = user_id));


--
-- Name: homeworks Allow select for user's own homeworks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow select for user's own homeworks" ON public.homeworks FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.id = homeworks.user_id)))));


--
-- Name: homeworks Allow update for owner; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow update for owner" ON public.homeworks FOR UPDATE USING ((auth.uid() = user_id));


--
-- Name: homeworks Allow update for owner's homeworks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow update for owner's homeworks" ON public.homeworks FOR UPDATE USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.id = homeworks.user_id)))));


--
-- Name: notifications Enable insert for authenticated users only; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable insert for authenticated users only" ON public.notifications FOR INSERT TO authenticated WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.id = notifications.user_id)))));


--
-- Name: available_courses Enable read access for all users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable read access for all users" ON public.available_courses FOR SELECT USING (true);


--
-- Name: courses_list Enable read access for all users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable read access for all users" ON public.courses_list FOR SELECT USING (true);


--
-- Name: courses_tariffs Enable read access for all users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable read access for all users" ON public.courses_tariffs FOR SELECT USING (true);


--
-- Name: free_lessons Enable read access for all users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable read access for all users" ON public.free_lessons FOR SELECT TO authenticated USING (true);


--
-- Name: photosession Enable read access for all users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable read access for all users" ON public.photosession FOR SELECT TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.available_courses @> ARRAY['2'::text])))));


--
-- Name: profiles Enable users to view their own data only; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Enable users to view their own data only" ON public.profiles FOR SELECT TO authenticated USING (((( SELECT auth.uid() AS uid) = id) OR (role = 'admin'::text)));


