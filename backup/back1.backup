--
-- Name: free_lessons_filtered; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.free_lessons_filtered AS
 SELECT free_lessons.id,
    free_lessons.title,
    free_lessons.title_en,
        CASE
            WHEN (EXISTS ( SELECT 1
               FROM public.profiles
              WHERE ((profiles.id = auth.uid()) AND (profiles."hasSub" = true)))) THEN free_lessons.content
            ELSE NULL::text
        END AS content
   FROM public.free_lessons;


ALTER TABLE public.free_lessons_filtered OWNER TO postgres;

