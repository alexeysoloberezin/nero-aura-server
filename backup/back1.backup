-- Name: courses Insert only admin users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Insert only admin users" ON public.courses FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.profiles
  WHERE ((profiles.id = auth.uid()) AND (profiles.role = 'admin'::text)))));


