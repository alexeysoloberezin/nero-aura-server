COPY public.homeworks (id, created_at, lesson_id, user_id, file_url, comment, answer, files_url, messages, "readLastMessage") FROM stdin;
84	2025-04-29 10:54:47.943229+00	1	441d06fa-d2f2-42c5-9154-a45f87f504c6	\N	* Название бренда: Мяу-Маркет\n\n* Целевая аудитория:\nЛюбители котиков 🐱\n— Люди всех возрастов, которые обожают кошек: у кого есть свои питомцы или кто мечтает их завести.\n— Они покупают себе товары с изображением котов (одежду, аксессуары, посуду, наклейки, подарки).\n\nПоддерживающие благотворительность ❤️\n— Волонтеры или люди, которые любят помогать животным, участвуют в благотворительных акциях, поддерживают приюты.\n— Они будут особенно заинтересованы, зная, что покупка помогает бездомным котикам.\n\nМолодежь и миллениалы (18–35 лет) 🎒\n— Эта аудитория любит нестандартные, милые, эмоциональные вещи, активно покупает тематические товары.\n— Им важно, чтобы покупки имели "ценность" — социальную миссию, поддержку добра.\n\nПодарочная аудитория 🎁\n— Люди, ищущие оригинальные подарки для друзей, коллег, родственников. Особенно на праздники, такие как Новый год, 8 марта, День рождения.\n\nАктивные пользователи соцсетей 📱\n— Те, кто любит милый визуальный контент (фото/видео с котиками) и легко делает покупки через Instagram, TikTok или маркетплейсы.\n\nЕсли коротко, моя основная ЦА — это любители котиков 18–45 и более лет, которые ценят милые вещи и готовы поддержать доброе дело через покупку.\n\n* Основное сообщение бренда:\n1) Основное сообщение бренда "Мяу-Маркет":\n"Мяу-Маркет — товары с котиками ради помощи котикам! 🐾\nМы продаем милые вещи по доступным ценам, чтобы вместе с вами менять жизнь бездомных котиков к лучшему.\nКаждая покупка помогает кормить, лечить и заботиться о хвостиках, а наша большая мечта — открыть собственный приют.\nДавайте строить мир доброты вместе!"\n\n2) "Мяу-Маркет — товары с котиками для тех, кто любит помогать! 🐾💖\nМы продаем милые аксессуары и товары, которые дарят радость, а с каждой покупкой ты помогаешь спасать бездомных котиков.\nВыручка с покупки - их кормление, лечение и один шаг к созданию нового дома. Вместе мы можем построить приют, где каждый хвостик обретет любовь и заботу.\nПрисоединяйся к нам — давай делать мир лучше для котиков!"\n\nСлоган для профиля или рекламы:\n"Мяу-Маркет: покупай выгодно - помогай котикам с любовью! 🐱💛"\n\n* Цветовая палитра для бренда:\nРекомендуемая цветовая схема:\nОсновные цвета: Мятный, персиковый, лаванда, пудрово-розовый.\nАкценты: Желтый, малиновый, золотистый.\nНейтральные оттенки: Светлый серый, белый, теплый бежевый.\nКонтраст: Черный для текста.\nЭта палитра передает теплоту, дружелюбие и нежность, отражая суть бренда — помощь котикам и создание позитивного и заботливого пространства для всех любителей животных.\n\n* Варианты слоганов\n"Покупай с любовью — спасай котиков!"\n"Милые вещи, добрые дела!"\n"С каждой покупкой — помощь котикам!"\n"Подарки с хвостиками, добро с сердцем!"\n	\N	"[\\"/uploads/1745924087733-1745924086545-9026d4e7-933f-4c88-9ae1-82e7fe0d06e6.jpg\\"]"	[{"userId": "441d06fa-d2f2-42c5-9154-a45f87f504c6", "message": "* Название бренда: Мяу-Маркет\\n\\n* Целевая аудитория:\\nЛюбители котиков 🐱\\n— Люди всех возрастов, которые обожают кошек: у кого есть свои питомцы или кто мечтает их завести.\\n— Они покупают себе товары с изображением котов (одежду, аксессуары, посуду, наклейки, подарки).\\n\\nПоддерживающие благотворительность ❤️\\n— Волонтеры или люди, которые любят помогать животным, участвуют в благотворительных акциях, поддерживают приюты.\\n— Они будут особенно заинтересованы, зная, что покупка помогает бездомным котикам.\\n\\nМолодежь и миллениалы (18–35 лет) 🎒\\n— Эта аудитория любит нестандартные, милые, эмоциональные вещи, активно покупает тематические товары.\\n— Им важно, чтобы покупки имели \\"ценность\\" — социальную миссию, поддержку добра.\\n\\nПодарочная аудитория 🎁\\n— Люди, ищущие оригинальные подарки для друзей, коллег, родственников. Особенно на праздники, такие как Новый год, 8 марта, День рождения.\\n\\nАктивные пользователи соцсетей 📱\\n— Те, кто любит милый визуальный контент (фото/видео с котиками) и легко делает покупки через Instagram, TikTok или маркетплейсы.\\n\\nЕсли коротко, моя основная ЦА — это любители котиков 18–45 и более лет, которые ценят милые вещи и готовы поддержать доброе дело через покупку.\\n\\n* Основное сообщение бренда:\\n1) Основное сообщение бренда \\"Мяу-Маркет\\":\\n\\"Мяу-Маркет — товары с котиками ради помощи котикам! 🐾\\nМы продаем милые вещи по доступным ценам, чтобы вместе с вами менять жизнь бездомных котиков к лучшему.\\nКаждая покупка помогает кормить, лечить и заботиться о хвостиках, а наша большая мечта — открыть собственный приют.\\nДавайте строить мир доброты вместе!\\"\\n\\n2) \\"Мяу-Маркет — товары с котиками для тех, кто любит помогать! 🐾💖\\nМы продаем милые аксессуары и товары, которые дарят радость, а с каждой покупкой ты помогаешь спасать бездомных котиков.\\nВыручка с покупки - их кормление, лечение и один шаг к созданию нового дома. Вместе мы можем построить приют, где каждый хвостик обретет любовь и заботу.\\nПрисоединяйся к нам — давай делать мир лучше для котиков!\\"\\n\\nСлоган для профиля или рекламы:\\n\\"Мяу-Маркет: покупай выгодно - помогай котикам с любовью! 🐱💛\\"\\n\\n* Цветовая палитра для бренда:\\nРекомендуемая цветовая схема:\\nОсновные цвета: Мятный, персиковый, лаванда, пудрово-розовый.\\nАкценты: Желтый, малиновый, золотистый.\\nНейтральные оттенки: Светлый серый, белый, теплый бежевый.\\nКонтраст: Черный для текста.\\nЭта палитра передает теплоту, дружелюбие и нежность, отражая суть бренда — помощь котикам и создание позитивного и заботливого пространства для всех любителей животных.\\n\\n* Варианты слоганов\\n\\"Покупай с любовью — спасай котиков!\\"\\n\\"Милые вещи, добрые дела!\\"\\n\\"С каждой покупкой — помощь котикам!\\"\\n\\"Подарки с хвостиками, добро с сердцем!\\"\\n"}, {"userId": "441d06fa-d2f2-42c5-9154-a45f87f504c6", "message": "Когда смогу начать следующий урок?"}, {"userId": "441d06fa-d2f2-42c5-9154-a45f87f504c6", "message": "открылось"}, {"userId": "9bb60211-56e7-4008-980f-bf8817ef5c4d", "message": "вау у вас логотип очень классный!  Очень красиво! ничего лишнего и привлекает внимание! у вас открылся 3й урок?"}]	f
